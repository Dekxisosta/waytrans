---
import Button from './Button.astro';
---

<header class="bg-white border-b-2 border-black sticky top-0 z-50">
  <div class="max-w-6xl mx-auto px-5 flex items-center gap-4 h-16">
    <a href="/" class="flex items-center gap-2 font-bold text-2xl tracking-tight no-underline">
      <span class="w-8 h-8 rounded-lg bg-blue-500 border-2 border-black grid place-items-center font-mono font-bold text-sm text-white">文A</span>
      waytrans
    </a>
    <nav class="ml-auto flex gap-6 items-center">
      <a href="/#install" class="font-bold tracking-widest uppercase text-xs no-underline hover:text-blue-600">Install</a>
      <a href="/#how" class="font-bold tracking-widest uppercase text-xs no-underline hover:text-blue-600">How</a>
      <a href="/docs" class="font-bold tracking-widest uppercase text-xs no-underline hover:text-blue-600">Docs</a>
      <Button variant="primary" href="https://github.com/remsysc/waytrans" target="_blank" rel="noopener">
        ★ GitHub
      </Button>
    </nav>
  </div>
</header>